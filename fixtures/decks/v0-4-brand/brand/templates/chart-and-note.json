{
  "schemaVersion": "0.4",
  "id": "chart-and-note",
  "name": "Chart and note",
  "description": "One finding: a heading that states it, the chart that shows it, and a short note on how to read it.",
  "slots": [
    {
      "id": "title",
      "role": "title",
      "frame": { "x": 6, "y": 6, "w": 88, "h": 14 },
      "accepts": ["heading"],
      "required": true,
      "hint": "The finding, as one sentence."
    },
    {
      "id": "chart",
      "role": "content",
      "frame": { "x": 6, "y": 24, "w": 58, "h": 68 },
      "accepts": ["chart", "table", "image"],
      "required": true,
      "hint": "The chart or table that shows the finding."
    },
    {
      "id": "note",
      "role": "body",
      "frame": { "x": 68, "y": 24, "w": 26, "h": 68 },
      "accepts": ["body", "quote"],
      "max": 2,
      "style": "quiet-panel",
      "hint": "How to read the chart, in one or two short paragraphs."
    }
  ]
}
