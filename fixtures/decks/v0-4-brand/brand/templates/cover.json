{
  "schemaVersion": "0.4",
  "id": "cover",
  "name": "Cover",
  "description": "The first slide: the deck's title on the brand's color, with a label above it and who presents it below.",
  "background": { "color": "action" },
  "chrome": "minimal",
  "slots": [
    {
      "id": "kicker",
      "role": "body",
      "frame": { "x": 8, "y": 20, "w": 60, "h": 8 },
      "accepts": ["caption"],
      "hint": "A short label above the title, such as the quarter."
    },
    {
      "id": "title",
      "role": "title",
      "frame": { "x": 8, "y": 30, "w": 84, "h": 30 },
      "accepts": ["heading"],
      "required": true,
      "valign": "bottom",
      "hint": "The deck's title, in a few words."
    },
    {
      "id": "byline",
      "role": "subtitle",
      "frame": { "x": 8, "y": 70, "w": 60, "h": 12 },
      "accepts": ["body", "caption"],
      "hint": "Who presents, and when."
    }
  ]
}
