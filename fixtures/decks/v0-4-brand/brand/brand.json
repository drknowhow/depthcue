{
  "schemaVersion": "0.4",
  "id": "harbor",
  "name": "Harbor Analytics",
  "colors": {
    "paper": { "action": "#0B6E6E", "evidence": "#2D4BB8", "chart": ["#0B6E6E", "#2D4BB8", "#B4531F"] },
    "ink": { "chart": ["#4FC4C4", "#8FA5FF", "#F0A06A"] }
  },
  "fonts": {
    "display": {
      "family": "Harbor Display",
      "license": "OFL-1.1",
      "files": [{ "file": "fonts/HarborSans-Bold.woff2", "weight": 700, "style": "normal" }]
    },
    "body": {
      "family": "Harbor Sans",
      "license": "OFL-1.1",
      "files": [
        { "file": "fonts/HarborSans-Regular.woff2", "weight": 400, "style": "normal" },
        { "file": "fonts/HarborSans-Bold.woff2", "weight": 700, "style": "normal" }
      ]
    },
    "fallback": "modern"
  },
  "logos": { "light": "logos/harbor.svg", "alt": "Harbor Analytics" },
  "chrome": {
    "logo": { "corner": "top-end", "size": "s" },
    "footer": { "text": "Harbor Analytics, for internal use", "place": "start" },
    "number": { "place": "end" },
    "accent": "top"
  },
  "styles": {
    "kicker": { "name": "Kicker", "for": ["caption"], "case": "upper", "weight": "bold", "tone": "action" },
    "quiet-panel": {
      "name": "Quiet panel",
      "for": ["body", "quote"],
      "fill": "surface",
      "border": "line",
      "radius": "m",
      "pad": "m"
    }
  }
}
