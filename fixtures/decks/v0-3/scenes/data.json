{
  "schemaVersion": "0.3",
  "id": "data",
  "title": "The numbers",
  "layout": "claim-evidence",
  "summary": {
    "id": "data-claim",
    "text": "Channel B now leads, 60 to 40.",
    "evidenceIds": ["data-chart", "data-table"]
  },
  "blocks": [
    {
      "id": "data-chart",
      "type": "chart",
      "kind": "bar",
      "title": "Share of orders by quarter",
      "unit": "%",
      "columns": [
        { "label": "Quarter" },
        { "label": "Channel A", "color": "muted" },
        { "label": "Channel B", "color": "action" }
