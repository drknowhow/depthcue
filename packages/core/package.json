{
  "name": "@depthcue/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/deck.schema.json": "./schema/deck.schema.json",
    "./schema/scene.schema.json": "./schema/scene.schema.json",
    "./schema/ops.schema.json": "./schema/ops.schema.json",
    "./schema/comments.schema.json": "./schema/comments.schema.json",
    "./schema/comment-ops.schema.json": "./schema/comment-ops.schema.json",
    "./schema/brand.schema.json": "./schema/brand.schema.json",
    "./schema/template.schema.json": "./schema/template.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "schema": "node scripts/build-schema.mjs",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "json-schema-to-ts": "^3.1.1"
  }
}
