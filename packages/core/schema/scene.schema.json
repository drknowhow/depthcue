{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:depthcue:schema:0.1:scene",
  "title": "Depthcue scene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "layout",
    "blocks"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 300
    },
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "layout": {
      "enum": [
        "title",
        "claim-evidence",
        "text-media"
      ]
    },
    "lead": {
      "enum": [
        "human",
        "agent",
        "shared"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "uniqueItems": true,
          "maxItems": 32
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "discriminator": {
          "propertyName": "type"
        },
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "role",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,63}$"
              },
              "type": {
                "const": "text"
              },
              "role": {
                "enum": [
                  "heading",
                  "body",
                  "caption",
                  "quote"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{1,63}$"
                },
                "uniqueItems": true,
                "maxItems": 32
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "heading"
                    }
                  },
                  "required": [
                    "role"
                  ]
                },
                "then": {
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 90
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "caption"
                    }
                  },
                  "required": [
                    "role"
                  ]
                },
                "then": {
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 160
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "quote"
                    }
                  },
                  "required": [
                    "role"
                  ]
                },
                "then": {
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 300
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "asset",
              "alt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,63}$"
              },
              "type": {
                "const": "image"
              },
              "asset": {
                "type": "string",
                "pattern": "^assets/(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$",
                "maxLength": 200
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "caption": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{1,63}$"
                },
                "uniqueItems": true,
                "maxItems": 32
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,63}$"
              },
              "type": {
                "const": "bar-chart"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "data": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "value"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                }
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{1,63}$"
                },
                "uniqueItems": true,
                "maxItems": 32
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "source",
              "alt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,63}$"
              },
              "type": {
                "const": "clip"
              },
              "source": {
                "type": "string",
                "pattern": "^assets/(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$",
                "maxLength": 200
              },
              "poster": {
                "type": "string",
                "pattern": "^assets/(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$",
                "maxLength": 200
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{1,63}$"
                },
                "uniqueItems": true,
                "maxItems": 32
              }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "asset": {
            "type": "string",
            "pattern": "^assets/(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$",
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\s]+$",
            "maxLength": 500
          }
        }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reveal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "reveal": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}$"
            },
            "uniqueItems": true,
            "maxItems": 32,
            "minItems": 1
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    }
  }
}
