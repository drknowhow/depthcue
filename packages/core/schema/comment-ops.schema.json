{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:depthcue:schema:0.2:comment-ops",
  "title": "Depthcue comment operations",
  "type": "array",
  "minItems": 1,
  "maxItems": 100,
  "items": {
    "type": "object",
    "discriminator": {
      "propertyName": "op"
    },
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "scene",
          "block",
          "anchor",
          "author",
          "text"
        ],
        "properties": {
          "op": {
            "const": "comment.add"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "scene": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "block": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "author": {
            "enum": [
              "you",
              "agent"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "ask": {
            "type": "boolean"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "id",
          "author",
          "text"
        ],
        "properties": {
          "op": {
            "const": "comment.reply"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "author": {
            "enum": [
              "you",
              "agent"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "id"
        ],
        "properties": {
          "op": {
            "const": "comment.resolve"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "id"
        ],
        "properties": {
          "op": {
            "const": "comment.reopen"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "id"
        ],
        "properties": {
          "op": {
            "const": "comment.delete"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          }
        }
      }
    ]
  }
}
