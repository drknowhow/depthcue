{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:depthcue:schema:0.3:deck",
  "title": "Depthcue deck manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "language",
    "theme",
    "scenes"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 300
    },
    "schemaVersion": {
      "enum": [
        "0.1",
        "0.2",
        "0.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "maxLength": 35
    },
    "theme": {
      "enum": [
        "paper",
        "ink"
      ]
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "bg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "maxLength": 7
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "maxLength": 7
        },
        "line": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "maxLength": 7
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "maxLength": 7
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "maxLength": 7
        },
        "action": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "maxLength": 7
        },
        "evidence": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "maxLength": 7
        }
      }
    },
    "fonts": {
      "enum": [
        "editorial",
        "modern",
        "classic",
        "technical"
      ]
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,63}$"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 200
    },
    "modules": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(off|[0-9]{1,4}(\\.[0-9]{1,4}){0,2})$",
        "maxLength": 16
      }
    }
  }
}
