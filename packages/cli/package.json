{
  "name": "@depthcue/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "depthcue": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./deck-api": {
      "types": "./dist/deck-api.d.ts",
      "default": "./dist/deck-api.js"
    },
    "./comments-api": {
      "types": "./dist/comments-api.d.ts",
      "default": "./dist/comments-api.js"
    },
    "./audit-file": {
      "types": "./dist/audit-file.d.ts",
      "default": "./dist/audit-file.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "default": "./dist/link.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "default": "./dist/images.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "default": "./dist/export.js"
    },
    "./pptx": {
      "types": "./dist/pptx/index.d.ts",
      "default": "./dist/pptx/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@depthcue/core": "workspace:*",
    "@depthcue/editor": "workspace:*",
    "@depthcue/player": "workspace:*",
    "jszip": "3.10.1",
    "playwright-core": "1.64.0",
    "pptxgenjs": "4.0.1"
  }
}
