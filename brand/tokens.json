{
  "$description": "Depthcue design tokens in DTCG form with hex colours. Edit this file, then run `pnpm tokens` to regenerate tokens.css.",
  "color": {
    "$type": "color",
    "brand": {
      "vermilion": {
        "$value": "#FF633F",
        "$description": "The cue. Fills, marks and the cue dot. On paper it fails 3:1, so text and controls use theme.paper.action."
      },
      "cobalt": {
        "$value": "#2B55E6",
        "$description": "Evidence: charts, source links, anything that backs a claim."
      },
      "lime": {
        "$value": "#B9F45D",
        "$description": "Meaningful state: live, current, done. Always paired with ink text or a shape, never colour alone."
      },
      "ink": { "$value": "#14161B" },
      "paper": { "$value": "#F5F2EA" }
    },
    "theme": {
      "paper": {
        "bg": { "$value": "#F5F2EA" },
        "surface": { "$value": "#FBF9F4" },
        "line": { "$value": "#D8D3C4" },
        "text": { "$value": "#14161B" },
        "muted": { "$value": "#4B505B" },
        "action": { "$value": "#C73A18" },
        "evidence": { "$value": "#2B55E6" },
        "state": { "$value": "#B9F45D" },
        "on-state": { "$value": "#14161B" }
      },
      "ink": {
        "bg": { "$value": "#0C0E12" },
        "surface": { "$value": "#161A21" },
        "line": { "$value": "#2A303A" },
        "text": { "$value": "#F2EFE6" },
        "muted": { "$value": "#A5ABB8" },
        "action": { "$value": "#FF633F" },
        "evidence": { "$value": "#7C9BFF" },
        "state": { "$value": "#B9F45D" },
        "on-state": { "$value": "#0C0E12" }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Instrument Serif", "Iowan Old Style", "Georgia", "serif"] },
    "ui": { "$value": ["Space Grotesk", "system-ui", "sans-serif"] },
    "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "Consolas", "monospace"] }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "18px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "220ms" },
      "slow": { "$value": "420ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0.05, 0.7, 0.1, 1] }
    }
  }
}
